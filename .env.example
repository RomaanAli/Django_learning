# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored and must NEVER be committed.
#   cp .env.example .env   (or open .env in an editor)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# E-mail (OTP verification)
# Development: leave empty — the console backend prints the OTP in the terminal.
# To actually receive real e-mails locally, fill in your provider's values, e.g.
# Gmail (use a 16-character App Password, NOT your normal password):
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx
#   EMAIL_USE_TLS=true
#   DEFAULT_FROM_EMAIL=you@gmail.com
# Production (Railway): fill these in so the OTP is emailed for real.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=

# Stripe payments (TEST keys — never commit real ones, and never put them in
# templates/JavaScript; they are only read server-side).
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx    (from Stripe > Developers > Webhooks)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd