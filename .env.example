# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored and must NEVER be committed.
#   cp .env.example .env   (or open .env in an editor)

# Database — PostgreSQL is REQUIRED (SQLite support was removed).
# Local development: fill in your own connection string, e.g.
#   DATABASE_URL=postgresql://postgres:<password>@127.0.0.1:5432/elearning
# On Render leave this out of .env — the managed Postgres instance sets
# DATABASE_URL automatically in the service environment.
DATABASE_URL=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# While the OAuth consent screen is in "Testing" status, the Google account
# you sign in with MUST be listed under "Test users" in the Google Cloud
# Console (APIs & Services -> OAuth consent screen), otherwise Google shows
# "Access blocked" when you click "Continue with Google".
#
# The OAuth client above must be of type "Web application" and its
# "Authorized redirect URIs" must contain BOTH loopback callbacks verbatim
# (scheme, port and trailing slash matter) — for a server on port 8000:
#   http://localhost:8000/accounts/google/login/callback/
#   http://127.0.0.1:8000/accounts/google/login/callback/
# If you run on a different port, the port in both URLs changes. The exact
# redirect_uri this app is sending right now is printed at
#   http://localhost:8000/accounts/google-check/

# E-mail (OTP verification)
# Development: leave empty — the console backend prints the OTP in the terminal.
#
# Brevo transactional email API (HTTPS port 443). REQUIRED on Render free
# instances, which BLOCK outbound SMTP (ports 25/465/587) — plain SMTP can
# never deliver from those hosts.
# Get the key in Brevo: profile menu -> "SMTP & API" -> "API Keys" -> generate.
# It starts with "xkeysib-"; this is NOT the SMTP key from the "SMTP" tab.
# The app tries Brevo first and falls back to SMTP, then to the console.
BREVO_API_KEY=
# The From address. With Brevo it MUST be a sender verified inside Brevo.
DEFAULT_FROM_EMAIL=
# Optional: seconds to wait before giving up on a transport (default 15).
# EMAIL_TIMEOUT=15

# SMTP (kept as the fallback: used locally, on a VPS and on paid Render
# instances — everywhere outbound SMTP is actually reachable).
# To actually receive real e-mails locally, fill in your provider's values, e.g.
# Gmail (use a 16-character App Password, NOT your normal password):
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx
#   EMAIL_USE_TLS=true
#   DEFAULT_FROM_EMAIL=you@gmail.com
# Brevo's own relay (only useful where SMTP is not blocked):
#   EMAIL_HOST=smtp-relay.brevo.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=<your Brevo SMTP login>
#   EMAIL_HOST_PASSWORD=<your Brevo SMTP key>
#
# NOTE: setting EMAIL_BACKEND here (or in the service environment) DISABLES the Brevo/SMTP
# fallback chain and pins a single backend — leave it empty unless you want
# that (e.g. the console backend for local development).
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=

# Stripe payments (TEST keys — never commit real ones, and never put them in
# templates/JavaScript; they are only read server-side).
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_CURRENCY=usd
#   STRIPE_WEBHOOK_SECRET is OPTIONAL. Without it the success page itself
#   verifies the payment with Stripe and enrols the student straight away.
#   Add it only if you later create a webhook at Stripe > Developers > Webhooks.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd